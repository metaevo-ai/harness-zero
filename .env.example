# Copy to .env and fill in what you use:  cp .env.example .env
# Rollouts pass this file to Harbor via --env-file (repo root .env by default).
# .env is gitignored — never commit real keys.

# --- Student / teacher model routes -----------------------------------------
# At least one route is required; which one depends on the models you pass to
# `harness-zero plan-rollout` (see README "Main experiments").

# Official OpenAI (student via Responses API, and teacher_provider=openai).
# Also used as a fallback key for OpenRouter when OPENROUTER_API_KEY is unset.
OPENAI_API_KEY=

# OpenRouter (student or teacher via OpenRouter).
OPENROUTER_API_KEY=

# Azure AI Foundry (student_model=azure:<deployment> and teacher_provider=azure
# or azure_openai). Both are required for any Azure route.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# --- Training (uv sync --group tinker) ---------------------------------------
# Tinker API key for harness-zero train-sft.
TM_API_KEY=

# --- Optional ----------------------------------------------------------------
# Override the OpenAI endpoint (rare; an endpoint containing "openrouter" is
# treated as an OpenRouter route).
# OPENAI_BASE_URL=

# Teacher concurrency cap per process (default 6).
# HARNESS_ZERO_TEACHER_MAX_CONCURRENCY=6

# Directory containing the optional HTML review renderer used by
# envs/appworld/build_sft.py (see that file's REVIEW_RENDERER_PATH handling).
# REVIEW_RENDERER_PATH=
